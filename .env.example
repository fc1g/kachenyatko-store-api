ENVIRONMENT=development
PORT=8080

LOG_LEVEL=info
LOG_PRETTY=false

# Address to listen on. 127.0.0.1: only a proxy on the same host can reach the API.
HTTP_HOST=127.0.0.1

# Header with the real client IP, set by a trusted proxy in front of the API.
# Empty: use the TCP connection address (local development, no proxy).
# Production behind Cloudflare Tunnel: CF-Connecting-IP
# Never set it when the API port is reachable directly: the header can be spoofed.
HTTP_CLIENT_IP_HEADER=

DB_URL=postgres://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}?sslmode=disable
DB_PING_TIMEOUT=2s
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=toystore

R2_ENDPOINT=https://account-id.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=test-access-key
R2_SECRET_ACCESS_KEY=test-secret-key
R2_BUCKET_NAME=test-bucket
R2_PUBLIC_URL=https://pub.example.com

TELEGRAM_ACCESS_TOKEN=test-access-token
TELEGRAM_CHAT_ID=123456789
TELEGRAM_SEND_TIMEOUT=10s

AUTH_SIGNING_KEY=dGVzdC1hY2Nlc3MtcHJpdmF0ZS1rZXk=
AUTH_ISSUER=test-issuer
AUTH_TOKEN_TTL=25m

# Storefront origin: the only origin allowed by CORS. In development, the frontend dev server.
SITE_URL=https://example.com

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=testPass1234!
